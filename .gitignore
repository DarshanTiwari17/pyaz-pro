# ============================================================
# PYAAZ-PRO
# Full Git Ignore
# React/Vite + Python/FastAPI + Streamlit + ML
# ============================================================


# ============================================================
# FRONTEND — REACT / VITE / NODE
# ============================================================

# Node dependencies
node_modules/
frontend/node_modules/

# Production / build output
dist/
frontend/dist/
build/
frontend/build/

# Vite
.vite/
frontend/.vite/

# npm logs
npm-debug.log*
npm-error.log*

# Yarn logs
yarn-debug.log*
yarn-error.log*

# pnpm logs
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/
.pnpm-store/

# TypeScript
*.tsbuildinfo

# ESLint
.eslintcache


# ============================================================
# FRONTEND ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Keep example environment files
!.env.example
!frontend/.env.example


# ============================================================
# PYTHON / FASTAPI
# ============================================================

# Python cache
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python compiled files
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

backend/venv/
backend/.venv/
backend/env/

# Python packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

*.egg-info/
.installed.cfg
*.egg

# Pip cache
pip-wheel-metadata/
.pip-cache/

# Testing
.pytest_cache/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# Pytype
.pytype/

# Ruff
.ruff_cache/


# ============================================================
# PYTHON ENVIRONMENT VARIABLES / SECRETS
# ============================================================

backend/.env
backend/.env.*
!backend/.env.example

.env
.env.*
!.env.example


# ============================================================
# DATABASE
# ============================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Project database
backend/pyaaz_pro.db


# ============================================================
# RUNTIME STORAGE
# ============================================================

# Uploaded images
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# Generated reports
backend/storage/reports/*
!backend/storage/reports/.gitkeep

# Temporary storage
backend/storage/temp/*
!backend/storage/temp/.gitkeep

# Runtime generated data
backend/storage/runtime/*
!backend/storage/runtime/.gitkeep


# ============================================================
# DATASETS
# ============================================================

# Local datasets
datasets/
dataset/
data/

backend/datasets/
backend/dataset/
backend/data/

# Runtime dataset storage
backend/storage/datasets/*
!backend/storage/datasets/.gitkeep

# Dataset archives
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# Large data files
*.csv
*.parquet
*.feather
*.pkl
*.pickle

# If you have small CSV/config files that MUST be committed,
# remove the *.csv rule above.


